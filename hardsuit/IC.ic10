alias Helmet d0
alias Jetpack d1

alias ExteriorPressure r1
alias ExteriorTemperature r2
alias HelmetOpened r3
alias activate r4

loop:
yield
s db Filtration 1
s db PressureSetting 90
s db TemperatureSetting 293
l HelmetOpened d0 Open
l ExteriorPressure db PressureExternal
l ExteriorTemperature db TemperatureExternal
jal control_helmet_status
jal control_atmosphere
jal control_air_release
j loop

close_helmt:
s Helmet Open 0
s Helmet Lock 1
j loop

control_air_release:
seqz activate HelmetOpened
s db AirRelease activate
j ra

control_helmet_status:
blt ExteriorPressure 50 close_helmt
bgt ExteriorPressure 150 close_helmt
blt ExteriorTemperature 273 close_helmt
bgt ExteriorTemperature 313 close_helmt
s Helmet Lock 0
j ra

control_atmosphere:
beqz HelmetOpened ra
#l r0 db RatioCarbonDioxide
#bgt r0 0.01 close_helmt
l r0 db RatioHelium
bgt r0 0.01 close_helmt
l r0 db RatioHyrdrazine
bgt r0 0.01 close_helmt
l r0 db RatioHyrdrogen
bgt r0 0.01 close_helmt
l r0 db RatioNitrousOxide
bgt r0 0.01 close_helmt
l r0 db RatioOzone
blt r0 0.30 close_helmt
l r0 db RatioPollutant
bgt r0 0.01 close_helmt
l r0 db RatioSilanol
bgt r0 0.01 close_helmt
l r0 db RatioOxygen
blt r0 0.30 close_helmt
j ra
